 = model.predict(X_test)\n","    y_prob = model.predict_proba(X_test)[:,1]\n","\n","    accuracy = accuracy_score(y_test, y_pred)\n","    auc = roc_auc_score(y_test, y_prob)\n","    loss = log_loss(y_test, y_prob)\n","\n","    print(\"Accuracy:\", accuracy)\n","    print(\"ROC-AUC:\", auc)\n","    print(\"Log Loss:\", loss)\n","    print(\"\\nClassification Report:\\n\", classification_report(y_test, y_pred))\n","\n","    cm = confusion_matrix(y_test, y_pred)\n","    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues') # Fixed 'camp' to 'cmap'\n","    plt.title(\"Confusion Matrix\")\n","    plt.xlabel(\"Predicted\") # Fixed 'xlable' to 'xlabel'\n","    plt.ylabel(\"Actual\")   # Fixed 'ylable' to 'ylabel'\n","    plt.show()\n","\n","print(\"Logistic Regression\")\n","evaluate(log_model)\n","\n","print(\"Random Forest\")\n","evaluate(rf_model)\n","\n","print(\"XGBoost\")\n","evaluate(xgb_model)\n","\n","print(\"Neural Network\")\n","evaluate(nn_model)"]},{"cell_type":"markdown","metadata":{"id":"alR1FEBnIo_o"},"source":["This code evaluates and compares the performance of Logistic Regression, Random Forest, and XGBoost models using metrics such as Accuracy, ROC-AUC, Classification Report, and Confusion Matrix.\n","\n","The results show that all models achieved good performance with accuracy above 81%. Logistic Regression obtained 81.56% accuracy and 0.8897 ROC-AUC, showing stable classification performance. Random Forest achieved the best performance with 83.24% accuracy and 0.9023 ROC-AUC, indicating the strongest ability to distinguish survival classes. XGBoost also performed well with 82.68% accuracy and 0.8946 ROC-AUC, slightly below Random Forest. Overall, Random Forest was the best-performing model for Titanic survival prediction."]},{"cell_type":"markdown","metadata":{"id":"PgCNmqgcR9s7"},"source":["# STEP 12 — Hyperparameter Tuning (Random Forest)"]},{"cell_type":"code","execution_count":null,"metadata":{"id":"vLP_6igUR9s7","executionInfo":{"status":"aborted","